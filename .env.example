# engine-control environment (copy to .env; .env is gitignored)

# Development-control Telegram — MUST be a different bot from the product
# discovery bot. See README "Telegram setup".
DEV_TELEGRAM_BOT_TOKEN=
DEV_TELEGRAM_CHAT_ID=

# Worker dispatch lane: task (one-shot Scheduled Task, default) or direct
# (detached process). Both survive tick exit and SSH disconnect.
# EC_LANE=task

# Claude CLI executable override (default: claude on PATH)
# EC_CLAUDE_EXE=claude

# Minutes to wait before retrying after a model quota/limit hit (default 30)
# EC_QUOTA_RETRY_MIN=30

# --- test-only knobs (never set in production) ---
# EC_WORKER_CMD=python tests/stub_worker.py     # replaces claude for canary tests
# EC_ALLOW_NO_TELEGRAM=1                        # canary tests run without telegram
